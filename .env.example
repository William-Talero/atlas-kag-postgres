# ATLAS KAG · configuración
#
# Dos modos de conexión. En Azure no se guarda contraseña: PG_AUTH=entra usa un
# token de Microsoft Entra ID y lo renueva solo; basta con `az login`.
# `infra/provision.sh` escribe este archivo por ti.

# ── Azure ──────────────────────────────────────────────────────────────────
PG_HOST=pg-atlas-kag-XXXXXX.postgres.database.azure.com
PG_PORT=5432
PG_DB=atlas
PG_USER=tu-usuario@tu-tenant.onmicrosoft.com
PG_AUTH=entra
PG_SSLMODE=require

# ── Local con docker compose (mismo motor AGE, mismo Cypher) ───────────────
# PG_HOST=localhost
# PG_PORT=5432
# PG_DB=atlas
# PG_USER=atlas
# PG_PASSWORD=atlas
# PG_AUTH=password
# PG_SSLMODE=prefer

GRAFO=atlas
EMBED_DIM=256
DEMO_MODE=live
